-- Compute prescribed rest duration based on superset position
-- Mid-superset (not the last exercise in group) → 0 rest
-- End of superset or standalone → prescribed seconds (default ~90-120s for resistance)
rule rest_duration(exercise_id: String, set_index: Int, superset_pos: Int, superset_size: Int)
  -> Int

if (superset_pos < superset_size - 1)
then 0
else 90
