-- Compute prescribed rest duration based on superset groups
-- If next exercise is in same superset group → 0 rest (mid-superset)
-- Otherwise or if last exercise → prescribed seconds from currentEntry.restSeconds
rule rest_duration(
  currentEntry: { supersetGroup: String, restSeconds: Int, .. },
  nextEntry: { supersetGroup: String, .. },
  isLastExercise: Bool
) -> Int

if (isLastExercise)
then 0
else if (currentEntry.supersetGroup != "" && currentEntry.supersetGroup == nextEntry.supersetGroup)
then 0
else currentEntry.restSeconds
