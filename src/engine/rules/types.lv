-- HMBWorkout engine types: phases, events, effects, and state structure

type Phase = Idle | Warmup | Working | Resting | Paused | Done

-- Aliases with dependencies must be defined before types that use them
alias LoggedSet = { exerciseId: String, setType: String, reps: Option(Int), weightKg: Option(Float), durationSeconds: Option(Int), rpe: Option(Float) }

-- One prescribed set. setType is the PLANNED type ("warmup" | "normal"),
-- distinct from LoggedSet.setType, which is what was actually recorded
-- ("warmup" | "working" | "stretch" | "cardio") and is derived at LogSet time
-- from this plus the entry's kind.
-- restSeconds is the set's OWN rest override (#281): Some overrides the entry's
-- restSeconds, None inherits it. Both ScheduleRest sites in transition.lv read
-- the just-completed set's value via h.completed_set_rest. The superset no-rest
-- hop never reads it and must stay rest-free regardless.
alias RoutineSet = { setType: String, reps: Option(Int), repsMax: Option(Int), weightKg: Option(Float), durationSeconds: Option(Int), distanceM: Option(Float), restSeconds: Option(Int) }

-- The entry is an ordered LIST of prescribed sets, not a pair of counts: a
-- warmup ramp (9.07 -> 11.34 -> 18.14 kg) is unrepresentable as "3 warmup
-- sets". Still a CLOSED record — the host rebuilds it field by field in both
-- directions, so a field bolted on in TS vanishes at the first dispatch.
alias RoutineEntry = { exerciseId: String, kind: String, restSeconds: Int, supersetGroup: Option(String), sets: List(RoutineSet) }

alias Routine = { entries: List(RoutineEntry), id: String }

alias SessionSummary = { startMs: Int, endMs: Int, exercisesCompleted: Int, setsLogged: Int, loggedSets: List(LoggedSet) }

-- Now define types that depend on the above aliases
-- ReplaceExercise swaps which movement an entry names, and nothing else: the
-- targets, warmups, rest and superset grouping of entry `idx` are the plan and
-- survive the swap. It carries `idx` rather than acting on exerciseIndex
-- implicitly because the substitute arrives from a network round-trip — the
-- workout may have advanced under the picker, and a stale choice must be
-- rejected rather than applied to whatever entry is current by then.
type Event = StartSession({ sessionId: String, nowMs: Int, routine: Routine }) | LogSet({ reps: Option(Int), weightKg: Option(Float), durationSeconds: Option(Int), rpe: Option(Float), nowMs: Int }) | SetDone({ nowMs: Int }) | RestElapsed({ nowMs: Int }) | SkipRest | ReplaceExercise({ idx: Int, exerciseId: String }) | PauseSession({ nowMs: Int }) | Resume({ nowMs: Int }) | AppForegrounded({ nowMs: Int }) | FinishSession({ nowMs: Int }) | AbandonSession

-- DiscardSession is the counterpart to CompleteSession, not a variant of it:
-- CompleteSession is what drives the HealthKit export, so an abandoned workout
-- must emit DiscardSession and never CompleteSession.
type Effect = CreateSession({ sessionId: String, routineId: String, startedAtMs: Int }) | ScheduleRest({ deadlineMs: Int }) | CancelRest | Notify({ message: String }) | PersistSet({ set: LoggedSet }) | CompleteSession({ summary: SessionSummary }) | DiscardSession({ sessionId: String })

-- restRemainingMs: rest time frozen while paused mid-rest; Some only in Paused phase
alias SessionState = { sessionId: String, routineId: String, phase: Phase, exerciseIndex: Int, setIndex: Int, supersetPosition: Int, restDeadlineMs: Option(Int), restRemainingMs: Option(Int), prePausePhase: Option(Phase), loggedSets: List(LoggedSet), lastLoggedSet: Option(LoggedSet), startedAtMs: Int, entries: List(RoutineEntry) }

alias TransitionResult = { state: SessionState, effects: List(Effect) }

true
