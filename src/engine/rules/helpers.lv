import "types" as t

-- Convert Phase to string for error messages
let phase_to_string = fn(phase) -> (
  match phase {
    Idle -> "idle",
    Warmup -> "warmup",
    Working -> "working",
    Resting -> "resting",
    Paused -> "paused",
    Done -> "done"
  }
)

-- Validate set input: reps, weight, duration, RPE
-- Returns Ok("valid") or Err(reason)
let validate_set = fn(set) -> (
  let valid_reps = match set.reps {
    None -> true,
    Some(r) -> r >= 0
  }
  let valid_weight = match set.weightKg {
    None -> true,
    Some(w) -> w >= 0.0
  }
  let valid_duration = match set.durationSeconds {
    None -> true,
    Some(d) -> d >= 0
  }

  let _ = require(valid_reps, "reps must be non-negative")?
  let _ = require(valid_weight, "weightKg must be non-negative")?
  let _ = require(valid_duration, "durationSeconds must be non-negative")?

  -- RPE validation: None (unset) or 1-10 in 0.5 steps
  let valid_rpe = match set.rpe {
    None -> true,
    Some(r) -> (r >= 1.0 && r <= 10.0) && ((r * 2.0) % 1.0) == 0.0
  }

  let _ = require(valid_rpe, "RPE must be unset or between 1.0 and 10.0 in 0.5-step increments")?

  Ok("valid")
)

-- Which phase (Warmup vs Working) applies to `entry` at the given 0-based
-- position in its own sets — i.e. how many of its own warmup+working sets
-- have already been logged. Shared by every "recover phase from position"
-- site (RestElapsed, SkipRest, superset advancement) so they can never
-- disagree.
let phase_for = fn(entry) -> fn(setIndex) -> (
  if (setIndex < entry.warmupSets) then Warmup else Working
)

-- Last index (inclusive), starting from groupStartIdx, of the contiguous run
-- of entries sharing `label` (interop's groupSupersets only ever collapses
-- *adjacent* same-label lines into one group, so a group is always a
-- contiguous slice — see src/interop/parse.ts). A standalone entry
-- (label: None) is a "group" of exactly itself: the scan stops at the very
-- next entry since None never matches None or Some in the equality check.
let group_end_idx = fn(entries) -> fn(groupStartIdx) -> fn(label) -> (
  fold(
    { idx: 0, open: true, endIdx: groupStartIdx },
    fn(acc) -> fn(entry) -> (
      if (acc.idx <= groupStartIdx)
      then { idx: acc.idx + 1, open: acc.open, endIdx: acc.endIdx }
      else if (!acc.open)
      then { idx: acc.idx + 1, open: false, endIdx: acc.endIdx }
      else (
        let matches = match (label, entry.supersetGroup) {
          (Some(c), Some(n)) -> c == n,
          _ -> false
        }
        if (matches)
        then { idx: acc.idx + 1, open: true, endIdx: acc.idx }
        else { idx: acc.idx + 1, open: false, endIdx: acc.endIdx }
      )
    ),
    entries
  ).endIdx
)

-- Smallest index in (afterIdx, groupEndIdx] whose own warmupSets+targetSets
-- still owes a set at `round` (0-based, so a member is "active" at round r
-- iff r < its own total). None means nobody left in that window for this
-- round — the caller reads that as "round done" or "group done" depending on
-- the window it passed. A member with fewer total sets than its partner is
-- simply skipped once its own count is exhausted, rather than ending the
-- group's round for everyone (the earlier, wrong behavior this replaced).
let next_active_idx = fn(entries) -> fn(afterIdx) -> fn(groupEndIdx) -> fn(round) -> (
  fold(
    { idx: 0, found: None },
    fn(acc) -> fn(entry) -> (
      match acc.found {
        Some(f) -> { idx: acc.idx + 1, found: acc.found },
        None ->
          if (acc.idx > afterIdx && acc.idx <= groupEndIdx && round < (entry.warmupSets + entry.targetSets))
          then { idx: acc.idx + 1, found: Some(acc.idx) }
          else { idx: acc.idx + 1, found: None }
      }
    ),
    entries
  ).found
)

-- Where a fresh landing at or after `fromIdx` actually lands: the smallest
-- index whose own warmupSets+targetSets is nonzero (a member is "active" at
-- a fresh landing's round 0 iff 0 < its own total), together with the start
-- of whichever contiguous supersetGroup run (or standalone singleton) it
-- belongs to. The group start has to be tracked rather than assumed to be
-- fromIdx, because a landing can skip an entire zero-set group to reach a
-- LATER group whose own leading member(s) are also zero-set — supersetPosition
-- must still be computed relative to THAT group's true start, or the next
-- advance_after_set call rederives the wrong groupEndIdx from it. None means
-- every entry from fromIdx to the end of the routine plans zero total sets.
-- Precondition: fromIdx is itself already a group boundary (0, or one past a
-- prior group's end) — both call sites in transition.lv satisfy this.
let next_active_landing = fn(entries) -> fn(fromIdx) -> (
  fold(
    { idx: 0, groupStart: fromIdx, prevLabel: None, found: None },
    fn(acc) -> fn(entry) -> (
      match acc.found {
        Some(f) -> { idx: acc.idx + 1, groupStart: acc.groupStart, prevLabel: acc.prevLabel, found: acc.found },
        None ->
          if (acc.idx < fromIdx)
          then { idx: acc.idx + 1, groupStart: acc.groupStart, prevLabel: acc.prevLabel, found: None }
          else (
            let sameGroupAsPrev = match (acc.prevLabel, entry.supersetGroup) {
              (Some(p), Some(c)) -> p == c,
              _ -> false
            }
            let groupStart = if (acc.idx == fromIdx) then fromIdx else if (sameGroupAsPrev) then acc.groupStart else acc.idx
            let isActive = (entry.warmupSets + entry.targetSets) > 0
            let found = if (isActive) then Some({ idx: acc.idx, groupStart: groupStart }) else None
            { idx: acc.idx + 1, groupStart: groupStart, prevLabel: entry.supersetGroup, found: found }
          )
      }
    ),
    entries
  ).found
)

-- Count of distinct exercises with at least one logged set — "touched", not
-- necessarily finished (a FinishSession mid-round counts an exercise the
-- athlete only did one round of). Used for the session-complete summary's
-- exercisesCompleted field, which must stay monotonic: exerciseIndex itself
-- moves backward each round while cycling through a superset group, so it
-- can't serve as a completion count once a group is involved. This is the
-- closest available approximation to that field's name, not a perfect one.
let distinct_exercise_count = fn(loggedSets) -> (
  length(fold(
    [],
    fn(seen) -> fn(set) -> if (contains(set.exerciseId, seen)) then seen else append(seen, [set.exerciseId]),
    loggedSets
  ))
)

0
