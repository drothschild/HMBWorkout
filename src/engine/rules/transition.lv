-- Import types and helpers
import "types" as types
import "helpers" as h

-- Rule signature uses unqualified type names from types module scope
rule transition(state: SessionState, event: Event) -> Result(TransitionResult)

(match event {
  StartSession(p) if state.phase == Idle -> (
      let entries = p.routine.entries
      let firstEntry = at(0, entries)?
      let firstPhase = if (firstEntry.warmupSets > 0) then Warmup else Working
      Ok({
        state: {
          sessionId: p.sessionId,
          routineId: p.routine.id,
          phase: firstPhase,
          exerciseIndex: 0,
          setIndex: 0,
          supersetPosition: 0,
          restDeadlineMs: None,
          restRemainingMs: None,
          prePausePhase: None,
          loggedSets: [],
          lastLoggedSet: None,
          startedAtMs: p.nowMs,
          entries: entries
        },
        effects: [CreateSession({ sessionId: p.sessionId, routineId: p.routine.id, startedAtMs: p.nowMs })]
      })
    ),
  StartSession(p) -> Err("invalid event StartSession in phase " ++ h.phase_to_string(state.phase)),
  LogSet(p) if state.phase != Idle && state.phase != Done && state.phase != Paused -> (
      let setInput = { reps: p.reps, weightKg: p.weightKg, durationSeconds: p.durationSeconds, rpe: p.rpe }
      let _ = h.validate_set(setInput)?
      let currentEntry = at(state.exerciseIndex, state.entries)?
      let isWarmup = state.setIndex < currentEntry.warmupSets
      let setType = if (isWarmup) then "warmup" else if (currentEntry.kind == "strength") then "working" else currentEntry.kind
      let theSet = { exerciseId: currentEntry.exerciseId, setType: setType, reps: p.reps, weightKg: p.weightKg, durationSeconds: p.durationSeconds, rpe: p.rpe }

      Ok({
        state: { state |
          loggedSets: append(state.loggedSets, [theSet]),
          lastLoggedSet: Some(theSet)
        },
        effects: [PersistSet({ set: theSet })]
      })
    ),
  LogSet(p) -> Err("invalid event LogSet in phase " ++ h.phase_to_string(state.phase)),
  SetDone(p) if state.phase != Idle && state.phase != Done && state.phase != Paused -> (
      let currentEntry = at(state.exerciseIndex, state.entries)?
      let isWarmup = state.setIndex < currentEntry.warmupSets
      let nextSetIndex = state.setIndex + 1
      let allSetsForEntry = currentEntry.warmupSets + currentEntry.targetSets
      let exerciseDone = nextSetIndex >= allSetsForEntry

      if (!exerciseDone)
      then (
        let newPhase = if (isWarmup && nextSetIndex >= currentEntry.warmupSets) then Working else state.phase
        Ok({
          state: { state | phase: newPhase, setIndex: nextSetIndex, restDeadlineMs: None },
          effects: []
        })
      )
      else (
        let nextExerciseIndex = state.exerciseIndex + 1
        let workoutDone = nextExerciseIndex >= length(state.entries)

        if (workoutDone)
        then Ok({
          state: { state | phase: Done, restDeadlineMs: None },
          effects: [CompleteSession({ summary: { startMs: state.startedAtMs, endMs: p.nowMs, exercisesCompleted: state.exerciseIndex, setsLogged: length(state.loggedSets), loggedSets: state.loggedSets } }), Notify({ message: "Workout complete" })]
        })
        else (
          let nextEntry = at(nextExerciseIndex, state.entries)?
          let sameSuperset = match (currentEntry.supersetGroup, nextEntry.supersetGroup) {
            (Some(c), Some(n)) -> c == n,
            _ -> false
          }

          if (sameSuperset)
          then Ok({
            state: { state | exerciseIndex: nextExerciseIndex, setIndex: 0, supersetPosition: state.supersetPosition + 1, restDeadlineMs: None },
            effects: []
          })
          else (
            let restSeconds = h.rest_duration(currentEntry)(nextEntry)(false)
            let restDeadlineMs = p.nowMs + restSeconds * 1000

            if (restSeconds > 0)
            then Ok({
              state: { state | phase: Resting, exerciseIndex: nextExerciseIndex, setIndex: 0, supersetPosition: 0, restDeadlineMs: Some(restDeadlineMs) },
              effects: [ScheduleRest({ deadlineMs: restDeadlineMs })]
            })
            else Ok({
              state: { state | exerciseIndex: nextExerciseIndex, setIndex: 0, supersetPosition: 0, restDeadlineMs: None },
              effects: []
            })
          )
        )
      )
    ),
  SetDone(p) -> Err("invalid event SetDone in phase " ++ h.phase_to_string(state.phase)),
  RestElapsed(p) if state.phase == Resting -> (
      if (p.nowMs < match state.restDeadlineMs { Some(d) -> d, None -> 0 })
      then Err("rest not elapsed")
      else (
        let currentPhase = if (length(state.entries) > 0) then Working else Idle
        Ok({
          state: { state | phase: currentPhase, setIndex: 0, supersetPosition: 0, restDeadlineMs: None },
          effects: [CancelRest]
        })
      )
    ),
  RestElapsed(p) -> Err("invalid event RestElapsed in phase " ++ h.phase_to_string(state.phase)),
  SkipRest if state.phase == Resting -> (
      Ok({
        state: { state | phase: Working, setIndex: 0, supersetPosition: 0, restDeadlineMs: None, restRemainingMs: None },
        effects: [CancelRest]
      })
    ),
  SkipRest if state.phase == Paused && state.restRemainingMs != None -> (
      Ok({
        state: { state | phase: Working, setIndex: 0, supersetPosition: 0, restDeadlineMs: None, restRemainingMs: None, prePausePhase: None },
        effects: []
      })
    ),
  SkipRest -> Err("invalid event SkipRest in phase " ++ h.phase_to_string(state.phase)),
  SkipExercise if state.phase != Idle && state.phase != Done -> (
      Ok({
        state: { state | exerciseIndex: state.exerciseIndex + 1, setIndex: 0, supersetPosition: 0, restDeadlineMs: None, restRemainingMs: None },
        effects: []
      })
    ),
  SkipExercise -> Err("invalid event SkipExercise in phase " ++ h.phase_to_string(state.phase)),
  PauseSession(p) if state.phase != Idle && state.phase != Done && state.phase != Paused -> (
      let remaining = match state.restDeadlineMs {
        Some(d) -> Some(d - p.nowMs),
        None -> None
      }
      let effects = match state.restDeadlineMs {
        Some(d) -> [CancelRest],
        None -> []
      }
      Ok({
        state: { state | phase: Paused, prePausePhase: Some(state.phase), restDeadlineMs: None, restRemainingMs: remaining },
        effects: effects
      })
    ),
  PauseSession(p) -> Err("invalid event PauseSession in phase " ++ h.phase_to_string(state.phase)),
  StartStretching if state.phase == Working || state.phase == Resting -> (
      let effects = match state.restDeadlineMs {
        Some(d) -> [CancelRest],
        None -> []
      }
      Ok({
        state: { state | phase: Stretching, restDeadlineMs: None },
        effects: effects
      })
    ),
  StartStretching -> Err("invalid event StartStretching in phase " ++ h.phase_to_string(state.phase)),
  Resume(p) if state.phase == Paused -> (
      match state.restRemainingMs {
        Some(r) -> (
          let deadline = p.nowMs + r
          Ok({
            state: { state | phase: Resting, restDeadlineMs: Some(deadline), restRemainingMs: None, prePausePhase: None },
            effects: [ScheduleRest({ deadlineMs: deadline })]
          })
        ),
        None -> Ok({
          state: { state | phase: (match state.prePausePhase { Some(ph) -> ph, None -> Working }), prePausePhase: None },
          effects: []
        })
      }
    ),
  Resume(p) -> Err("invalid event Resume in phase " ++ h.phase_to_string(state.phase)),
  FinishSession(p) if state.phase != Idle && state.phase != Done -> (
      let effects = if (state.phase == Resting)
        then [CancelRest, CompleteSession({ summary: { startMs: state.startedAtMs, endMs: p.nowMs, exercisesCompleted: state.exerciseIndex, setsLogged: length(state.loggedSets), loggedSets: state.loggedSets } }), Notify({ message: "Workout complete" })]
        else [CompleteSession({ summary: { startMs: state.startedAtMs, endMs: p.nowMs, exercisesCompleted: state.exerciseIndex, setsLogged: length(state.loggedSets), loggedSets: state.loggedSets } }), Notify({ message: "Workout complete" })]

      Ok({
        state: { state | phase: Done, restDeadlineMs: None, restRemainingMs: None },
        effects: effects
      })
    ),
  FinishSession(p) -> Err("invalid event FinishSession in phase " ++ h.phase_to_string(state.phase))
})
