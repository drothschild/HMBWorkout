-- Main session state machine: (state, event) -> (new_state, effects)
--
-- Note on effect encoding: Rill has no union/discriminated types. To satisfy AC10.2
-- (type-checking via checkRuleSource), effects are encoded as uniform records:
--   { kind: String, deadline_ms: Int, message: String }
-- where `kind` tags the effect type ("create_session", "schedule_rest", etc.) and
-- deadline_ms/message carry payloads (sentinels 0/"" when unused). The host
-- (src/engine/index.ts) maps each uniform record to the typed Effect discriminated union.
-- This keeps AC10.1: Rill decides WHEN and WHAT effects, host never branches on session logic.

rule transition(state: { .. }, event: { tag: String, .. })
  -> Result({ state: { .. }, effects: List({ kind: String, deadline_ms: Int, message: String }) })

if (event.tag == "StartSession")
then (
  if (state.phase != "idle")
  then Err("invalid event StartSession")
  else Ok({ state: { sessionId: event.sessionId, routineId: event.routine.id, phase: if (event.routine.has_warmups) then "warmup" else "working", exerciseIndex: 0, setIndex: 0, supersetPosition: 0, restDeadlineMs: 0, loggedSets: [], startedAtMs: event.nowMs }, effects: [{ kind: "create_session", deadline_ms: 0, message: "" }] })
)
else if (event.tag == "LogSet")
then (
  if (state.phase == "idle" || state.phase == "done" || state.phase == "paused")
  then Err("invalid event LogSet")
  else (
    if (event.reps >= 0 && event.weightKg >= 0.0 && event.durationSeconds >= 0 && (event.rpe == -1.0 || (event.rpe >= 1.0 && event.rpe <= 10.0)))
    then Ok({ state: { sessionId: state.sessionId, routineId: state.routineId, phase: state.phase, exerciseIndex: state.exerciseIndex, setIndex: state.setIndex, supersetPosition: state.supersetPosition, restDeadlineMs: state.restDeadlineMs, loggedSets: state.loggedSets, startedAtMs: state.startedAtMs }, effects: [{ kind: "persist_set", deadline_ms: 0, message: "" }] })
    else (
      if (event.reps < 0) then Err("reps must be non-negative")
      else if (event.weightKg < 0.0) then Err("weight_kg must be non-negative")
      else if (event.durationSeconds < 0) then Err("duration_seconds must be non-negative")
      else Err("RPE must be -1.0 (unset) or between 1.0 and 10.0")
    )
  )
)
else if (event.tag == "SetDone")
then (
  if (state.phase == "idle")
  then Err("invalid event SetDone")
  else (
    if (state.phase == "warmup")
    then Ok({ state: { sessionId: state.sessionId, routineId: state.routineId, phase: "working", exerciseIndex: state.exerciseIndex, setIndex: state.setIndex + 1, supersetPosition: state.supersetPosition, restDeadlineMs: state.restDeadlineMs, loggedSets: state.loggedSets, startedAtMs: state.startedAtMs }, effects: [] })
    else Ok({ state: state, effects: [] })
  )
)
else if (event.tag == "RestElapsed")
then (
  if (state.phase != "resting")
  then Err("invalid event RestElapsed")
  else (
    if (event.nowMs < state.restDeadlineMs)
    then Err("rest not elapsed")
    else Ok({ state: { sessionId: state.sessionId, routineId: state.routineId, phase: "working", exerciseIndex: state.exerciseIndex, setIndex: state.setIndex, supersetPosition: state.supersetPosition, restDeadlineMs: 0, loggedSets: state.loggedSets, startedAtMs: state.startedAtMs }, effects: [{ kind: "cancel_rest", deadline_ms: 0, message: "" }] })
  )
)
else if (event.tag == "PauseSession")
then Ok({ state: { sessionId: state.sessionId, routineId: state.routineId, phase: "paused", exerciseIndex: state.exerciseIndex, setIndex: state.setIndex, supersetPosition: state.supersetPosition, restDeadlineMs: state.restDeadlineMs, loggedSets: state.loggedSets, startedAtMs: state.startedAtMs }, effects: [] })
else if (event.tag == "Resume")
then (
  if (state.phase != "paused")
  then Err("invalid event Resume")
  else (
    if (state.restDeadlineMs > 0 && event.nowMs >= state.restDeadlineMs)
    then Ok({ state: { sessionId: state.sessionId, routineId: state.routineId, phase: "working", exerciseIndex: state.exerciseIndex, setIndex: state.setIndex, supersetPosition: state.supersetPosition, restDeadlineMs: 0, loggedSets: state.loggedSets, startedAtMs: state.startedAtMs }, effects: [{ kind: "cancel_rest", deadline_ms: 0, message: "" }] })
    else Ok({ state: { sessionId: state.sessionId, routineId: state.routineId, phase: "resting", exerciseIndex: state.exerciseIndex, setIndex: state.setIndex, supersetPosition: state.supersetPosition, restDeadlineMs: state.restDeadlineMs, loggedSets: state.loggedSets, startedAtMs: state.startedAtMs }, effects: [] })
  )
)
else if (event.tag == "SkipExercise")
then Ok({ state: { sessionId: state.sessionId, routineId: state.routineId, phase: state.phase, exerciseIndex: state.exerciseIndex + 1, setIndex: state.setIndex, supersetPosition: state.supersetPosition, restDeadlineMs: 0, loggedSets: state.loggedSets, startedAtMs: state.startedAtMs }, effects: [] })
else if (event.tag == "FinishSession")
then Ok({ state: { sessionId: state.sessionId, routineId: state.routineId, phase: "done", exerciseIndex: state.exerciseIndex, setIndex: state.setIndex, supersetPosition: state.supersetPosition, restDeadlineMs: 0, loggedSets: state.loggedSets, startedAtMs: state.startedAtMs }, effects: [{ kind: "complete_session", deadline_ms: 0, message: "" }, { kind: "notify", deadline_ms: 0, message: "Workout complete" }] })
else Ok({ state: state, effects: [] })
