-- Import types and helpers
import "types" as types
import "helpers" as h

-- Rule signature uses unqualified type names from types module scope
rule transition(state: SessionState, event: Event) -> Result(TransitionResult)

(
-- Advancement after the set at the current position is finished. Shared by
-- LogSet (record then advance) and SetDone (advance without recording) so the
-- two events can never disagree on advancement. Curried like h.rest_duration.
let advance_after_set = fn(s) -> fn(nowMs) -> (
    let currentEntry = at(s.exerciseIndex, s.entries)?
    let isWarmup = s.setIndex < currentEntry.warmupSets
    let nextSetIndex = s.setIndex + 1
    let allSetsForEntry = currentEntry.warmupSets + currentEntry.targetSets
    let exerciseDone = nextSetIndex >= allSetsForEntry

    if (!exerciseDone)
    then (
      -- Rest between sets of the same exercise. Only from Warmup/Working so
      -- RestElapsed can recover the phase from setIndex vs warmupSets.
      let restBetweenSets = currentEntry.restSeconds > 0 && (s.phase == Warmup || s.phase == Working)
      if (restBetweenSets)
      then (
        let restDeadlineMs = nowMs + currentEntry.restSeconds * 1000
        Ok({
          state: { s | phase: Resting, setIndex: nextSetIndex, restDeadlineMs: Some(restDeadlineMs) },
          effects: [ScheduleRest({ deadlineMs: restDeadlineMs })]
        })
      )
      else (
        let newPhase = if (isWarmup && nextSetIndex >= currentEntry.warmupSets) then Working else s.phase
        Ok({
          state: { s | phase: newPhase, setIndex: nextSetIndex, restDeadlineMs: None },
          effects: []
        })
      )
    )
    else (
      let nextExerciseIndex = s.exerciseIndex + 1
      let workoutDone = nextExerciseIndex >= length(s.entries)

      if (workoutDone)
      then Ok({
        state: { s | phase: Done, restDeadlineMs: None },
        effects: [CompleteSession({ summary: { startMs: s.startedAtMs, endMs: nowMs, exercisesCompleted: s.exerciseIndex, setsLogged: length(s.loggedSets), loggedSets: s.loggedSets } }), Notify({ message: "Workout complete" })]
      })
      else (
        let nextEntry = at(nextExerciseIndex, s.entries)?
        let sameSuperset = match (currentEntry.supersetGroup, nextEntry.supersetGroup) {
          (Some(c), Some(n)) -> c == n,
          _ -> false
        }

        if (sameSuperset)
        then Ok({
          state: { s | exerciseIndex: nextExerciseIndex, setIndex: 0, supersetPosition: s.supersetPosition + 1, restDeadlineMs: None },
          effects: []
        })
        else (
          let restSeconds = h.rest_duration(currentEntry)(nextEntry)(false)
          let restDeadlineMs = nowMs + restSeconds * 1000

          if (restSeconds > 0)
          then Ok({
            state: { s | phase: Resting, exerciseIndex: nextExerciseIndex, setIndex: 0, supersetPosition: 0, restDeadlineMs: Some(restDeadlineMs) },
            effects: [ScheduleRest({ deadlineMs: restDeadlineMs })]
          })
          else Ok({
            state: { s | exerciseIndex: nextExerciseIndex, setIndex: 0, supersetPosition: 0, restDeadlineMs: None },
            effects: []
          })
        )
      )
    )
  )

match event {
  -- Accept StartSession from Idle (no prior session) or Done (terminal residue can be replaced).
  -- A finished session is inert data already persisted; starting a new one replaces it completely.
  StartSession(p) if state.phase == Idle || state.phase == Done -> (
      let entries = p.routine.entries
      let firstEntry = at(0, entries)?
      let firstPhase = if (firstEntry.warmupSets > 0) then Warmup else Working
      Ok({
        state: {
          sessionId: p.sessionId,
          routineId: p.routine.id,
          phase: firstPhase,
          exerciseIndex: 0,
          setIndex: 0,
          supersetPosition: 0,
          restDeadlineMs: None,
          restRemainingMs: None,
          prePausePhase: None,
          loggedSets: [],
          lastLoggedSet: None,
          startedAtMs: p.nowMs,
          entries: entries
        },
        effects: [CreateSession({ sessionId: p.sessionId, routineId: p.routine.id, startedAtMs: p.nowMs })]
      })
    ),
  StartSession(p) -> Err("invalid event StartSession in phase " ++ h.phase_to_string(state.phase)),
  -- Stretching is excluded: logging advances the workout, and the stretch
  -- cool-down must never advance anything (exit is StopStretching).
  LogSet(p) if state.phase != Idle && state.phase != Done && state.phase != Paused && state.phase != Stretching -> (
      let setInput = { reps: p.reps, weightKg: p.weightKg, durationSeconds: p.durationSeconds, rpe: p.rpe }
      let _ = h.validate_set(setInput)?
      let currentEntry = at(state.exerciseIndex, state.entries)?
      let isWarmup = state.setIndex < currentEntry.warmupSets
      let setType = if (isWarmup) then "warmup" else if (currentEntry.kind == "strength") then "working" else currentEntry.kind
      let theSet = { exerciseId: currentEntry.exerciseId, setType: setType, reps: p.reps, weightKg: p.weightKg, durationSeconds: p.durationSeconds, rpe: p.rpe }

      -- Record, then advance from the recorded state: one tap both logs the
      -- set and moves the position, so the entry caps at warmupSets +
      -- targetSets logs and the final set completes the workout. PersistSet
      -- must precede the advancement effects (CompleteSession drives sync).
      let recorded = { state |
        loggedSets: append(state.loggedSets, [theSet]),
        lastLoggedSet: Some(theSet)
      }
      let advanced = advance_after_set(recorded)(p.nowMs)?
      Ok({
        state: advanced.state,
        effects: append([PersistSet({ set: theSet })], advanced.effects)
      })
    ),
  LogSet(p) -> Err("invalid event LogSet in phase " ++ h.phase_to_string(state.phase)),
  SetDone(p) if state.phase != Idle && state.phase != Done && state.phase != Paused && state.phase != Stretching -> (
      advance_after_set(state)(p.nowMs)
    ),
  SetDone(p) -> Err("invalid event SetDone in phase " ++ h.phase_to_string(state.phase)),
  RestElapsed(p) if state.phase == Resting -> (
      if (p.nowMs < match state.restDeadlineMs { Some(d) -> d, None -> 0 })
      then Err("rest not elapsed")
      else (
        -- setIndex already points at the upcoming set (the previous LogSet or
        -- SetDone advanced it), so it must be preserved; the phase is
        -- recovered from its position.
        let currentEntry = at(state.exerciseIndex, state.entries)?
        let nextPhase = if (state.setIndex < currentEntry.warmupSets) then Warmup else Working
        Ok({
          state: { state | phase: nextPhase, restDeadlineMs: None },
          effects: [CancelRest]
        })
      )
    ),
  RestElapsed(p) -> Err("invalid event RestElapsed in phase " ++ h.phase_to_string(state.phase)),
  SkipRest if state.phase == Resting -> (
      let currentEntry = at(state.exerciseIndex, state.entries)?
      let nextPhase = if (state.setIndex < currentEntry.warmupSets) then Warmup else Working
      Ok({
        state: { state | phase: nextPhase, restDeadlineMs: None, restRemainingMs: None },
        effects: [CancelRest]
      })
    ),
  SkipRest if state.phase == Paused && state.restRemainingMs != None -> (
      let currentEntry = at(state.exerciseIndex, state.entries)?
      let nextPhase = if (state.setIndex < currentEntry.warmupSets) then Warmup else Working
      Ok({
        state: { state | phase: nextPhase, restDeadlineMs: None, restRemainingMs: None, prePausePhase: None },
        effects: []
      })
    ),
  SkipRest -> Err("invalid event SkipRest in phase " ++ h.phase_to_string(state.phase)),
  -- Stretching is excluded (symmetry with LogSet/SetDone): the cool-down must
  -- never advance the workout, and skipping the last exercise would push
  -- exerciseIndex out of range and strand StopStretching's entry lookup.
  SkipExercise if state.phase != Idle && state.phase != Done && state.phase != Stretching -> (
      Ok({
        state: { state | exerciseIndex: state.exerciseIndex + 1, setIndex: 0, supersetPosition: 0, restDeadlineMs: None, restRemainingMs: None },
        effects: []
      })
    ),
  SkipExercise -> Err("invalid event SkipExercise in phase " ++ h.phase_to_string(state.phase)),
  -- Substitute a different movement for the entry the athlete is facing.
  -- Warmup and Working only: those are the phases where an exercise is in
  -- progress and nothing about it is committed yet. Resting and Stretching sit
  -- between exercises, Paused is a held position, and Idle/Done have no entry
  -- to swap.
  ReplaceExercise(p) if state.phase == Warmup || state.phase == Working -> (
      -- Same-entry guard: the alternates come back from a network round-trip,
      -- so the pick names the entry it was made about and is rejected if the
      -- workout advanced past it.
      let _ = require(p.idx == state.exerciseIndex, "ReplaceExercise must target the current exercise")?
      -- Untouched-entry guard. setIndex advances on both LogSet and SetDone and
      -- resets to 0 on every entry change, so setIndex == 0 is an exactly
      -- entry-scoped "nothing recorded yet". Scanning loggedSets by exerciseId
      -- would not be: a routine may list the same movement twice, and the
      -- second entry would inherit the first's veto.
      let _ = require(state.setIndex == 0, "cannot replace an exercise once a set has already been recorded for it")?
      let _ = require(p.exerciseId != "", "ReplaceExercise requires a non-empty exerciseId")?
      -- Bounds check. Without it a stranded exerciseIndex would fall through
      -- the fold below matching nothing and silently rebuild the list unchanged.
      let _ = at(p.idx, state.entries)?

      -- Rill has no indexed assignment, so the list is rebuilt. fold carries a
      -- position counter alongside the list being built (the Rill RoutineEntry
      -- alias has no idx field — the host re-derives idx from array position on
      -- the way out), swapping exerciseId on the one entry whose position
      -- matches and copying every other entry through untouched. Order is
      -- preserved because append puts each rebuilt entry on the end.
      let rebuilt = fold(
        { position: 0, entries: [] },
        fn(acc) -> fn(entry) -> (
          let kept = if (acc.position == p.idx) then { entry | exerciseId: p.exerciseId } else entry
          { position: acc.position + 1, entries: append(acc.entries, [kept]) }
        ),
        state.entries
      )

      Ok({
        state: { state | entries: rebuilt.entries },
        effects: []
      })
    ),
  ReplaceExercise(p) -> Err("invalid event ReplaceExercise in phase " ++ h.phase_to_string(state.phase)),
  PauseSession(p) if state.phase != Idle && state.phase != Done && state.phase != Paused -> (
      let remaining = match state.restDeadlineMs {
        Some(d) -> Some(d - p.nowMs),
        None -> None
      }
      let effects = match state.restDeadlineMs {
        Some(d) -> [CancelRest],
        None -> []
      }
      Ok({
        state: { state | phase: Paused, prePausePhase: Some(state.phase), restDeadlineMs: None, restRemainingMs: remaining },
        effects: effects
      })
    ),
  PauseSession(p) -> Err("invalid event PauseSession in phase " ++ h.phase_to_string(state.phase)),
  StartStretching if state.phase == Working || state.phase == Resting -> (
      let effects = match state.restDeadlineMs {
        Some(d) -> [CancelRest],
        None -> []
      }
      Ok({
        state: { state | phase: Stretching, restDeadlineMs: None },
        effects: effects
      })
    ),
  StartStretching -> Err("invalid event StartStretching in phase " ++ h.phase_to_string(state.phase)),
  -- Exit the cool-down where it was entered: the phase is recovered from the
  -- position (the SkipRest/RestElapsed idiom), and the position is untouched.
  StopStretching if state.phase == Stretching -> (
      let currentEntry = at(state.exerciseIndex, state.entries)?
      let nextPhase = if (state.setIndex < currentEntry.warmupSets) then Warmup else Working
      Ok({
        state: { state | phase: nextPhase },
        effects: []
      })
    ),
  StopStretching -> Err("invalid event StopStretching in phase " ++ h.phase_to_string(state.phase)),
  Resume(p) if state.phase == Paused -> (
      match state.restRemainingMs {
        Some(r) -> (
          let deadline = p.nowMs + r
          Ok({
            state: { state | phase: Resting, restDeadlineMs: Some(deadline), restRemainingMs: None, prePausePhase: None },
            effects: [ScheduleRest({ deadlineMs: deadline })]
          })
        ),
        None -> Ok({
          state: { state | phase: (match state.prePausePhase { Some(ph) -> ph, None -> Working }), prePausePhase: None },
          effects: []
        })
      }
    ),
  -- A kill mid-rest (not paused) rehydrates Resting with its wall-clock
  -- deadline intact but no cancelable alert in the new process. The boot
  -- rehydrate (src/state/sessionRehydrate.ts) dispatches Resume for exactly
  -- this phase and Paused, so reconcile both directions here: a live deadline
  -- re-arms the alert (the shell's fixed notification identity makes the
  -- re-emit replace, not duplicate, a pre-kill alert); an expired one gets
  -- the same phase-from-position recovery RestElapsed would have made. The
  -- UI's Resume buttons render only while paused, so this arm is boot-only.
  Resume(p) if state.phase == Resting -> (
      match state.restDeadlineMs {
        Some(d) ->
          if (p.nowMs < d)
          then Ok({ state: state, effects: [ScheduleRest({ deadlineMs: d })] })
          else (
            let currentEntry = at(state.exerciseIndex, state.entries)?
            let nextPhase = if (state.setIndex < currentEntry.warmupSets) then Warmup else Working
            Ok({
              state: { state | phase: nextPhase, restDeadlineMs: None },
              effects: [CancelRest]
            })
          ),
        None -> Ok({ state: state, effects: [] })
      }
    ),
  Resume(p) -> Err("invalid event Resume in phase " ++ h.phase_to_string(state.phase)),
  FinishSession(p) if state.phase != Idle && state.phase != Done -> (
      let effects = if (state.phase == Resting)
        then [CancelRest, CompleteSession({ summary: { startMs: state.startedAtMs, endMs: p.nowMs, exercisesCompleted: state.exerciseIndex, setsLogged: length(state.loggedSets), loggedSets: state.loggedSets } }), Notify({ message: "Workout complete" })]
        else [CompleteSession({ summary: { startMs: state.startedAtMs, endMs: p.nowMs, exercisesCompleted: state.exerciseIndex, setsLogged: length(state.loggedSets), loggedSets: state.loggedSets } }), Notify({ message: "Workout complete" })]

      Ok({
        state: { state | phase: Done, restDeadlineMs: None, restRemainingMs: None },
        effects: effects
      })
    ),
  FinishSession(p) -> Err("invalid event FinishSession in phase " ++ h.phase_to_string(state.phase)),
  AbandonSession if state.phase != Idle && state.phase != Done -> (
      -- Throw the workout away. DiscardSession tells the host to delete the
      -- session and its sets; deliberately no CompleteSession, so nothing is
      -- synced to the vault or exported to HealthKit. A rest timer armed for
      -- the discarded workout has to be cancelled or it fires for a session
      -- that no longer exists. (Paused mid-rest already cancelled it, which is
      -- why this keys off restDeadlineMs rather than the phase.)
      let effects = match state.restDeadlineMs {
        Some(d) -> [CancelRest, DiscardSession({ sessionId: state.sessionId })],
        None -> [DiscardSession({ sessionId: state.sessionId })]
      }
      -- Return a fresh Idle state rather than a terminal one: Idle is the phase
      -- StartSession accepts, so a new workout can begin immediately after.
      Ok({
        state: {
          sessionId: "",
          routineId: "",
          phase: Idle,
          exerciseIndex: 0,
          setIndex: 0,
          supersetPosition: 0,
          restDeadlineMs: None,
          restRemainingMs: None,
          prePausePhase: None,
          loggedSets: [],
          lastLoggedSet: None,
          startedAtMs: 0,
          entries: []
        },
        effects: effects
      })
    ),
  -- Idle has no workout to abandon; Done is already written, synced and
  -- exported, so removing it is a different operation from abandoning one.
  AbandonSession -> Err("invalid event AbandonSession in phase " ++ h.phase_to_string(state.phase))
})
