-- Main session state machine: (state, event) -> (new_state, effects)
-- Standalone rule: all validation and rest logic inlined
-- Note: effects list must have uniform record structure in Rill, so all effects carry all possible fields (with defaults)
rule transition(state: { .. }, event: { tag: String, .. })
  -> Result({ state: { .. }, effects: List({ tag: String, .. }) })

if (event.tag == "StartSession")
then (
  if (state.phase != "idle")
  then Err("invalid event StartSession")
  else Ok({ state: { sessionId: event.sessionId, routineId: event.routine.id, phase: if (event.routine.has_warmups) then "warmup" else "working", exerciseIndex: 0, setIndex: 0, supersetPosition: 0, restDeadlineMs: 0, loggedSets: [], startedAtMs: event.nowMs }, effects: [{ tag: "CreateSession", sessionId: event.sessionId, routineId: event.routine.id, startedAtMs: event.nowMs, message: "", deadlineMs: 0, set: {}, summary: "" }] })
)
else if (event.tag == "LogSet")
then (
  if (state.phase == "idle" || state.phase == "done" || state.phase == "paused")
  then Err("invalid event LogSet")
  else (
    if (event.reps >= 0 && event.weightKg >= 0.0 && event.durationSeconds >= 0 && (event.rpe == -1.0 || (event.rpe >= 1.0 && event.rpe <= 10.0)))
    then Ok({ state: { sessionId: state.sessionId, routineId: state.routineId, phase: state.phase, exerciseIndex: state.exerciseIndex, setIndex: state.setIndex, supersetPosition: state.supersetPosition, restDeadlineMs: state.restDeadlineMs, loggedSets: state.loggedSets, startedAtMs: state.startedAtMs }, effects: [{ tag: "PersistSet", set: { exerciseId: "", setType: if (state.phase == "warmup") then "warmup" else "working", reps: event.reps, weightKg: event.weightKg, durationSeconds: event.durationSeconds, rpe: event.rpe }, message: "", sessionId: "", routineId: "", startedAtMs: 0, deadlineMs: 0, summary: 0 }] })
    else (
      if (event.reps < 0) then Err("reps must be non-negative")
      else if (event.weightKg < 0.0) then Err("weight_kg must be non-negative")
      else if (event.durationSeconds < 0) then Err("duration_seconds must be non-negative")
      else Err("RPE must be -1.0 (unset) or between 1.0 and 10.0")
    )
  )
)
else if (event.tag == "SetDone")
then (
  if (state.phase == "idle")
  then Err("invalid event SetDone")
  else (
    if (state.phase == "warmup")
    then Ok({ state: { sessionId: state.sessionId, routineId: state.routineId, phase: "working", exerciseIndex: state.exerciseIndex, setIndex: state.setIndex + 1, supersetPosition: state.supersetPosition, restDeadlineMs: state.restDeadlineMs, loggedSets: state.loggedSets, startedAtMs: state.startedAtMs }, effects: [] })
    else Ok({ state: state, effects: [] })
  )
)
else if (event.tag == "RestElapsed")
then (
  if (state.phase != "resting")
  then Err("invalid event RestElapsed")
  else (
    if (event.nowMs < state.restDeadlineMs)
    then Err("rest not elapsed")
    else Ok({ state: { sessionId: state.sessionId, routineId: state.routineId, phase: "working", exerciseIndex: state.exerciseIndex, setIndex: state.setIndex, supersetPosition: state.supersetPosition, restDeadlineMs: 0, loggedSets: state.loggedSets, startedAtMs: state.startedAtMs }, effects: [{ tag: "CancelRest", message: "", sessionId: "", routineId: "", startedAtMs: 0, deadlineMs: 0, set: {}, summary: "" }] })
  )
)
else if (event.tag == "PauseSession")
then Ok({ state: { sessionId: state.sessionId, routineId: state.routineId, phase: "paused", exerciseIndex: state.exerciseIndex, setIndex: state.setIndex, supersetPosition: state.supersetPosition, restDeadlineMs: state.restDeadlineMs, loggedSets: state.loggedSets, startedAtMs: state.startedAtMs }, effects: [] })
else if (event.tag == "Resume")
then (
  if (state.phase != "paused")
  then Err("invalid event Resume")
  else (
    if (state.restDeadlineMs > 0 && event.nowMs >= state.restDeadlineMs)
    then Ok({ state: { sessionId: state.sessionId, routineId: state.routineId, phase: "working", exerciseIndex: state.exerciseIndex, setIndex: state.setIndex, supersetPosition: state.supersetPosition, restDeadlineMs: 0, loggedSets: state.loggedSets, startedAtMs: state.startedAtMs }, effects: [{ tag: "CancelRest", message: "", sessionId: "", routineId: "", startedAtMs: 0, deadlineMs: 0, set: {}, summary: "" }] })
    else Ok({ state: { sessionId: state.sessionId, routineId: state.routineId, phase: "resting", exerciseIndex: state.exerciseIndex, setIndex: state.setIndex, supersetPosition: state.supersetPosition, restDeadlineMs: state.restDeadlineMs, loggedSets: state.loggedSets, startedAtMs: state.startedAtMs }, effects: [] })
  )
)
else if (event.tag == "SkipExercise")
then Ok({ state: { sessionId: state.sessionId, routineId: state.routineId, phase: state.phase, exerciseIndex: state.exerciseIndex + 1, setIndex: state.setIndex, supersetPosition: state.supersetPosition, restDeadlineMs: 0, loggedSets: state.loggedSets, startedAtMs: state.startedAtMs }, effects: [] })
else if (event.tag == "FinishSession")
then Ok({ state: { sessionId: state.sessionId, routineId: state.routineId, phase: "done", exerciseIndex: state.exerciseIndex, setIndex: state.setIndex, supersetPosition: state.supersetPosition, restDeadlineMs: 0, loggedSets: state.loggedSets, startedAtMs: state.startedAtMs }, effects: [{ tag: "CompleteSession", message: "", sessionId: "", routineId: "", startedAtMs: 0, deadlineMs: 0, set: {}, summary: "" }, { tag: "Notify", message: "Workout complete", sessionId: "", routineId: "", startedAtMs: 0, deadlineMs: 0, set: {}, summary: "" }] })
else Ok({ state: state, effects: [] })
