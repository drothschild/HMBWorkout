-- Validate set input: reps, weight, duration, RPE
-- Returns Ok("valid") or Err(reason)
-- RPE sentinel: -1.0 means unset (empty)
rule validate_set(set: { reps: Int, weight_kg: Float, duration_seconds: Int, rpe: Float, .. })
  -> Result(String)

let _ = require(set.reps >= 0, "reps must be non-negative")?
let _ = require(set.weight_kg >= 0.0, "weight_kg must be non-negative")?
let _ = require(set.duration_seconds >= 0, "duration_seconds must be non-negative")?

-- RPE validation: -1.0 (unset) or 1-10 in 0.5 steps
-- Check: if rpe != -1.0, then rpe must be a whole number or end with .5 (0.5-step)
let valid_rpe_range =
  if (set.rpe == -1.0)
  then true
  else (set.rpe >= 1.0 && set.rpe <= 10.0)

let valid_rpe_steps =
  if (set.rpe == -1.0)
  then true
  else ((set.rpe * 2.0) % 1.0) == 0.0

let _ = require(valid_rpe_range, "RPE must be -1.0 (unset) or between 1.0 and 10.0")?
let _ = require(valid_rpe_steps, "RPE must be in 0.5-step increments (e.g., 1.0, 1.5, 2.0, ..., 10.0)")?

Ok("valid")
